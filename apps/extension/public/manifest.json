{
  "manifest_version": 3,
  "name": "Pinkless",
  "version": "0.1.0",
  "description": "Find reviewed, comparable alternatives that cost less.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pinkless"
  },
  "content_scripts": [
    {
      "matches": ["https://www.cvs.com/*", "https://www.kroger.com/*", "https://www.walmart.com/*"],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ]
}
