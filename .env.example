# Use mock for credential-free local development. Use live (the default) on Vercel.
PINKLESS_PROVIDER_MODE=mock

# Exact comma-separated browser origins allowed to call the API.
# Add the deployed Marketplace origin and final chrome-extension:// ID later.
PINKLESS_ALLOWED_ORIGINS=http://localhost:5173

# Keep empty in production. Development responses include safe reason codes by default.
PINKLESS_DEBUG_REASONS=

# Server-side only. Add these to Vercel project settings; never prefix with VITE_.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Server-side only. Canopy is the Amazon data source approved for this project.
CANOPY_API_KEY=

# CVS and Walmart remain fail-closed shells until approved/licensed integrations exist.
# No credentials for those retailers are accepted by the application yet.
